{
  "name": "@smartfarm-os/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./sqlite-store": {
      "types": "./dist/sqlite-store.d.ts",
      "default": "./dist/sqlite-store.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test \"dist/**/*.test.js\""
  },
  "dependencies": {
    "@smartfarm-os/contracts": "0.1.0",
    "@smartfarm-os/module-sdk": "0.1.0",
    "fastify": "5.12.1"
  }
}
