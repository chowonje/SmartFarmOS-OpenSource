# Contest/pilot only. Do not publish this deployment without rotating secrets
# and replacing the simulator-backed demo with reviewed production services.

SMARTFARM_SITE_ADDRESS=
SMARTFARM_BASIC_AUTH_USER=
SMARTFARM_BASIC_AUTH_HASH=
SMARTFARM_DEMO_KEY=

# Optional server-only live weather credential. Leave blank for deterministic fixture data.
SMARTFARM_OPENWEATHER_API_KEY=

# Optional host port remaps. Leave these alone on a dedicated VM.
SMARTFARM_HTTP_PORT=80
SMARTFARM_HTTPS_PORT=443

# Optional SQLite location inside the persistent data volume.
SMARTFARM_DEMO_DB_PATH=/data/smartfarm-demo.sqlite
