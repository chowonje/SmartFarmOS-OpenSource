[Unit]
Description=SmartFarmOS Raspberry Pi Edge Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=smartfarm-edge
Group=smartfarm-edge
ExecStart=/usr/local/bin/smartfarm-edge run --config /etc/smartfarm-edge/config.json
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/smartfarm-edge
WorkingDirectory=/var/lib/smartfarm-edge

[Install]
WantedBy=multi-user.target
